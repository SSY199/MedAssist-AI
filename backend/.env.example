# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB (same database your app uses)
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
# Example: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=medassist_db

# FastAPI backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# External APIs
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
GEMINI_API_KEY=
CHROMA_DB_PATH=./chroma_data

# SOS sender: Gmail with 2-Step Verification and a dedicated app password.
# Server-only. Never use your ordinary Google password.
SOS_GMAIL_ADDRESS=
SOS_GMAIL_APP_PASSWORD=

# Reminder email uses the Gmail sender above; independent master switch.
REMINDERS_EMAIL_ENABLED=false
